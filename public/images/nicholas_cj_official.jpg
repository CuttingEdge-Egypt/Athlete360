ublic_id":"TeamUSA Assets/Gamification/Sydney 2000 Trivia/Reiling_Sara_2000","format":"jpg","secure_url":"https://res.cloudinary.com/usopc-prod/image/upload/v1757703209/TeamUSA%20Assets/Gamification/Sydney%202000%20Trivia/Reiling_Sara_2000.jpg","width":2390,"height":3548,"metadata":{"alt_text":"Sara Reiling diving","caption":"Sara Reiling competes during the 2000 Olympic Team Diving Trials in Federal Way, Washington.","photo_credit":"Getty Images","disable_transformations":false}}],"back_card_config":{},"_metadata":{"uid":"cs48663ef9ecc80551"}},{"title":"Jenny Keim","is_correct_answer":false,"front_image":[{"public_id":"TeamUSA Assets/Gamification/Sydney 2000 Trivia/Keim_J_Sydney_2000","format":"jpg","secure_url":"https://res.cloudinary.com/usopc-prod/image/upload/v1757702569/TeamUSA%20Assets/Gamification/Sydney%202000%20Trivia/Keim_J_Sydney_2000.jpg","width":1386,"height":2331,"metadata":{"alt_text":"Jenny Keim preparing to dive","caption":"Jenny Keim competes in the women's 3-meter springboard during the Olympic Games Sydney 2000 in Sydney.","photo_credit":"Getty Images","disable_transformations":false}}],"back_card_config":{},"_metadata":{"uid":"cs23ea1eb900d2ca62"}},{"title":"Laura Wilkinson","is_correct_answer":true,"front_image":[{"public_id":"TeamUSA Assets/Gamification/Sydney 2000 Trivia/Wilkinson_L_Sydney_2000","format":"jpg","secure_url":"https://res.cloudinary.com/usopc-prod/image/upload/v1757702390/TeamUSA%20Assets/Gamification/Sydney%202000%20Trivia/Wilkinson_L_Sydney_2000.jpg","width":2412,"height":3621,"metadata":{"alt_text":"Laura Wilkinson smiling","caption":"Laura Wilkinson stands atop the podium during the Olympic Games Sydney 2000 in Sydney.","photo_credit":"Getty Images","disable_transformations":false}}],"back_card_config":{},"_metadata":{"uid":"cs2f33138e672a2fc7"}}],"poll_results":{"result":"SUCCESS","votes_count":{"csd46f71b4afbb383b":3,"cs48663ef9ecc80551":12,"cs23ea1eb900d2ca62":26,"cs2f33138e672a2fc7":57}},"_metadata":{"uid":"cs39ba10c336f268de"}},"_metadata":{"uid":"cs39ba10c336f268de"}}],"uid":"bltbf46e267865ffcae","content_type_uid":"game","url":"/25-years-later-sydney-2000-trivia","title":"25 Years Later: Sydney 2000 Trivia","contains_forms":true,"content_tags":[],"open_graph_settings":{"description":"How well do you remember these iconic moments from the Olympic Games Sydney 2000?","preview_image":[],"image_is_logo":false,"title":"25 Years Later: Sydney 2000 Trivia","url":"https://www.teamusa.com/25-years-later-sydney-2000-trivia","type":"website"},"seo":{"meta_description":"Discover fascinating trivia from the Sydney 2000 Olympics, celebrating 25 years of unforgettable moments and sporting history.","canonical_url":"https://www.teamusa.com/25-years-later-sydney-2000-trivia","enable_search_indexing":true,"publisher":{"name":"Team USA","logo":"https://res.cloudinary.com/usopc-prod/image/upload/v1/TeamUSA%20Assets/Assets/Logo-main-teamUSA_xdtsfd?_a=DAJHqpE+ZAA0"}},"segmentation_tags":{},"disable_ads":false,"page_layout":{"hide_header":false,"hide_footer":false,"hide_footer_signup_form":false},"brightcove_player":{"account_id":"6057984930001","cms_id":"2700013","player_id":"0R9jTwnzf","thumbnail_player_id":"O50Xodn3j9"}},"_metadata":{"uid":"cs3f9d9b730efc1b7d"}}},{"content_tiles":{"title":"Team USA Celebrates Hispanic Heritage Month","description":"Hispanic Heritage Month runs from Sept. 15 to Oct. 15, and aims to highlight the achievements of the Hispanic community on and off the field of play.","number_of_columns":3,"background_image":[{"public_id":"TeamUSA Assets/Paris 2024/Top Shots Gallery/EiffelTowerStadium_Paris24","format":"jpg","secure_url":"https://res.cloudinary.com/usopc-prod/image/upload/v1722032391/TeamUSA%20Assets/Paris%202024/Top%20Shots%20Gallery/EiffelTowerStadium_Paris24.jpg","width":2188,"height":1367,"metadata":{"alt_text":"The Eiffel Tower and the stadium underneath it","caption":"A photo of the opening ceremonies of the Olympic Games Paris 2024 on July 26, 2024 in Paris.","photo_credit":"Getty Images","disable_transformations":false}}],"entries":[{"uid":"cs770f12afc1f02df0","title":"Natalia Grossman, Sport Climbing","description_jrte":{"uid":"7c69bd1e453b48b7964adff22710c358","type":"doc","attrs":{},"children":[{"uid":"080b63fc363c4dbe9ba89c0a04597dfd","type":"p","attrs":{},"children":[{"text":"“Hispanic Heritage Month gives me the chance to reflect on how my upbringing shaped who I am. When I was younger, I spent a lot of time in a different environment — speaking another language, living a different lifestyle and fully immersed in my culture. Those experiences gave me perspective and taught me to appreciate the opportunities and resources I have today. This month reminds me to celebrate those roots with pride and carry them forward in my daily life.”","italic":true,"children":[]}]}],"_metadata":{"uid":"7c69bd1e453b48b7964adff22710c358"},"rich_text":"\u003cp>\u003cem>“Hispanic Heritage Month gives me the chance to reflect on how my upbringing shaped who I am. When I was younger, I spent a lot of time in a different environment — speaking another language, living a different lifestyle and fully immersed in my culture. Those experiences gave me perspective and taught me to appreciate the opportunities and resources I have today. This month reminds me to celebrate those roots with pride and carry them forward in my daily life.”\u003c/em>\u003c/p>"},"tile_image":[{"public_id":"TeamUSA Assets/Athlete Profiles/batch images/grossman_n_hero","format":"png","secure_url":"https://res.cloudinary.com/usopc-prod/image/upload/v1687662461/TeamUSA%20Assets/Athlete%20Profiles/batch%20images/grossman_n_hero.png","width":1440,"height":1680,"metadata":{"alt_text":"Natalia Grossman smiles after a climb","caption":"Natalia Grossman","photo_credit":"USOPC","disable_transformations":false}}],"is_an_icon":false,"background":"blue","button_options":{"button_text":"Athlete Profile","url":"/profiles/natalia-grossman"}},{"uid":"cs9b0b58fc8d92e819","title":"Anita Alvarez, Artistic Swimming","description_jrte":{"uid":"435838b95af143ef8eb9da91d18bd078","type":"doc","attrs":{},"children":[{"uid":"14549af9acf34e69b569fa9a817aa9bb","type":"p","attrs":{},"children":[{"text":"“Hispanic Heritage Month is a time to celebrate the vibrant cultures, stories and traditions that shape our communities. As a Mexican-American, I’m proud to honor my roots and carry the passion, strength and creativity of my heritage into every moment — in and out of the pool.”","italic":true,"children":[]}]}],"_metadata":{"uid":"435838b95af143ef8eb9da91d18bd078"},"rich_text":"\u003cp>\u003cem>“Hispanic Heritage Month is a time to celebrate the vibrant cultures, stories and traditions that shape our communities. As a Mexican-American, I’m proud to honor my roots and carry the passion, strength and creativity of my heritage into every moment — in and out of the pool.”\u003c/em>\u003c/p>"},"tile_image":[{"public_id":"TeamUSA Assets/News/Alvarez_Anita_Worlds_2022_02","format":"jpg","secure_url":"https://res.cloudinary.com/usopc-prod/image/upload/v1698442881/TeamUSA%20Assets/News/Alvarez_Anita_Worlds_2022_02.jpg","width":3125,"height":2083,"metadata":{"alt_text":"Anita Alvarez swimming during the women's solo free.","caption":"Anita Alvarez competes during the women's solo free finals at the 2022 FINA World Championships on June 22, 2022 in Budapest, Hungary.","photo_credit":"Getty Images","disable_transformations":false}}],"is_an_icon":false,"background":"blue","button_options":{"button_text":"Athlete Profile","url":"/profiles/anita-alvarez-828944"}},{"uid":"csc4fabf50c2d6fd6e","title":"Hezly Rivera, Artistic Gymnastics","description_jrte":{"uid":"048d9baf99364ec0906e2ee4dd72761b","type":"doc","attrs":{},"children":[{"uid":"88d5f9d7a05b4ad0a66e742c66220875","type":"p","attrs":{},"children":[{"text":"“Hispanic Heritage is all about feeling connected to and staying rooted in my culture — the food, the music, the way my family comes together. It’s about being proud of where I come from. Shoutout to all the people from the Dominican Republic.”","italic":true,"children":[]},{"text":"\n","children":[]}]}],"_metadata":{"uid":"048d9baf99364ec0906e2ee4dd72761b"},"rich_text":"\u003cp>\u003cem>“Hispanic Heritage is all about feeling connected to and staying rooted in my culture — the food, the music, the way my family comes together. It’s about being proud of where I come from. Shoutout to all the people from the Dominican Republic.”\u003c/em>\u003cbr>\u003c/p>"},"tile_image":[{"public_id":"Rivera_Hezly_Paris24","format":"jpg","secure_url":"https://res.cloudinary.com/usopc-prod/image/upload/v1726501937/Rivera_Hezly_Paris24.jpg","width":2163,"height":3099,"metadata":{"alt_text":"Hezly Rivera of Team United States competes on the balance beam during the Artistic Gymnastics Women's Qualification on day two of the Olympic Games Paris 2024 at Bercy Arena on July 28, 2024 in Paris, France.","caption":"Hezly Rivera of Team United States competes on the balance beam during the Artistic Gymnastics Women's Qualification on day two of the Olympic Games Paris 2024 at Bercy Arena on July 28, 2024 in Paris, France.","photo_credit":"Getty Images","disable_transformations":false}}],"is_an_icon":false,"background":"blue","button_options":{"button_text":"Athlete Profile","url":"/profiles/hezly-rivera"}}],"_metadata":{"uid":"cs06088e8be9420a7b"}}},{"gallery_block":{"gallery":[{"uid":"bltcea5ba2fcb5e31dc","title":"On the Ice at Short Track U.S. Speedskating Championships","description":"On the Ice at Short Track U.S. Speedskating Championships","images":[{"gallery_image":[{"public_id":"TeamUSA Assets/2025/2025 Short Track Speedskating Championships/20250914_TeamUSA_Speedskating_Edited_16x9_7","format":"jpg","secure_url":"https://res.cloudinary.com/usopc-prod/image/upload/v1757895853/TeamUSA%20Assets/2025/2025%20Short%20Track%20Speedskating%20Championships/20250914_TeamUSA_Speedskating_Edited_16x9_7.jpg","width":3851,"height":2166,"metadata":{"alt_text":"